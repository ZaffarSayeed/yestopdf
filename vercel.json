{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://yestopdf.fastapicloud.dev"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

